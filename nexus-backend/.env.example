# Ollama server and model
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=gemma4:12b
# Context window passed to Ollama for structured agent calls
GEMMA_NUM_CTX=16384

# Server
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Helix guardrails
# Check chat replies with the output rail (adds one model call per message)
HELIX_OUTPUT_RAIL=true
# Block missions when the guardrails engine is unavailable (fail closed)
HELIX_GUARDRAILS_REQUIRED=false
